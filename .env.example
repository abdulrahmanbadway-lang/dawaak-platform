# انسخ الملف باسم .env.local (للتجربة المحلية) وحط نفس القيم في Vercel > Settings > Environment Variables
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# اختياري: 1 = رفع صور المنتجات على Firebase Storage (يحتاج خطة Blaze). الافتراضي: الصور بتتحفظ مضغوطة داخل Firestore
VITE_USE_STORAGE=0
VITE_FIREBASE_STORAGE_BUCKET=
