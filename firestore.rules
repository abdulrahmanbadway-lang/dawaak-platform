rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function touches(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasAny(keys); }
    function onlyKeys(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function destOk(d) { return d is map && d.keys().hasOnly(['lat', 'lng']) && d.lat is number && d.lng is number && d.lat >= -90 && d.lat <= 90 && d.lng >= -180 && d.lng <= 180; }
    // الأدمن: أول أدمن بيتحدد من Firebase Console (users/{uid}.role = 'admin')، وبعدها أي أدمن يرقّي حساب مريض من لوحة التحكم. التسجيل والتعديل الذاتي بيرفضوا الدور ده.
    function isAdmin() { return signed() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    // الحساب المحظور (users/{uid}.blocked == true) بيفقد كل صلاحيات الكتابة وقراءة الطلبات والروشتات. بيتحدد من لوحة الأدمن بس.
    function active() { return signed() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('blocked', false) != true; }
    function isPatient() { return active() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'patient'; }

    match /users/{uid} {
      allow read: if (signed() && request.auth.uid == uid) || isAdmin();
      allow create: if signed() && request.auth.uid == uid && request.resource.data.role in ['patient', 'pharmacy', 'courier']
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt']);
      allow update: if signed() && request.auth.uid == uid && request.resource.data.role == resource.data.role
        && resource.data.get('blocked', false) != true && !touches(['blocked', 'blockedAt']);
      // الأدمن: حظر / فك حظر حساب (مش أدمن تاني) وبس
      allow update: if isAdmin() && onlyKeys(['blocked', 'blockedAt']) && request.resource.data.blocked is bool && resource.data.role != 'admin';
      // الأدمن: يرقّي حساب مريض (مش محظور) لأدمن، أو يرجّع أدمن آخر لمريض. مينفعش يغيّر دور نفسه.
      allow update: if isAdmin() && onlyKeys(['role']) && request.auth.uid != uid
        && ((resource.data.role == 'patient' && request.resource.data.role == 'admin' && resource.data.get('blocked', false) != true)
         || (resource.data.role == 'admin' && request.resource.data.role == 'patient'));
    }

    match /pharmacies/{pid} {
      allow read: if true;
      allow create: if active() && request.auth.uid == pid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'pharmacy'
        && request.resource.data.verified == false;
      // الصيدلية متقدرش تغيّر التوثيق ولا الحالة ولا رقم الترخيص ولا اسم المسؤول
      allow update: if active() && request.auth.uid == pid
        && request.resource.data.verified == resource.data.verified
        && request.resource.data.status == resource.data.status
        && request.resource.data.license == resource.data.license
        && request.resource.data.ownerName == resource.data.ownerName;
      // الأدمن: يوثّق أو يوقف صيدلية، ومش بيغيّر أي حاجة تانية
      allow update: if isAdmin() && onlyKeys(['verified', 'status'])
        && request.resource.data.verified is bool && request.resource.data.status in ['active', 'suspended'];
    }

    // الإعلانات في الرئيسية: الكل يقرا، والأدمن بس يكتب (صورة JPEG مضغوطة أو بدون صورة، والرابط داخلي أو https)
    match /banners/{id} {
      function bnOk() {
        let d = request.resource.data;
        return d.keys().hasOnly(['title', 'sub', 'link', 'imageUrl', 'order', 'active', 'createdAt'])
          && d.title is string && d.title.size() <= 80 && d.sub is string && d.sub.size() <= 160
          && d.link is string && d.link.size() <= 300 && (d.link == '' || d.link.matches('#/.*') || d.link.matches('https://.*'))
          && d.imageUrl is string && d.imageUrl.size() <= 200000 && (d.imageUrl == '' || d.imageUrl.matches('data:image/jpeg;base64,.*'))
          && (d.imageUrl != '' || d.title.size() > 0)
          && d.order is number && d.active is bool;
      }
      allow read: if true;
      allow create, update: if isAdmin() && bnOk();
      allow delete: if isAdmin();
    }

    // بيانات تواصل الموقع: الكل يقرأ، والأدمن بس يكتب (إيميل / تليفون / واتساب)
    match /settings/contact {
      function ctOk() {
        let d = request.resource.data;
        return d.keys().hasOnly(['email', 'phone', 'whatsapp', 'updatedAt'])
          && d.email is string && d.email.size() <= 80 && (d.email == '' || d.email.matches('[^@ ]+@[^@ ]+[.][^@ ]+'))
          && d.phone is string && (d.phone == '' || d.phone.matches('[+]?[0-9 ]{6,20}'))
          && d.whatsapp is string && (d.whatsapp == '' || d.whatsapp.matches('[+]?[0-9 ]{6,20}'))
          && d.updatedAt == request.time;
      }
      allow read: if true;
      allow create, update: if isAdmin() && ctOk();
      allow delete: if isAdmin();
    }

    // آراء العملاء: رأي واحد لكل مريض (id = uid)، الاسم لازم يكون أول جزء من اسم حسابه. الأدمن يحذف أي رأي.
    match /reviews/{uid} {
      function rvOk() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'rating', 'text', 'createdAt', 'updatedAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 40
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name[0:d.name.size()] == d.name
          && d.rating is int && d.rating >= 1 && d.rating <= 5
          && d.text is string && d.text.size() >= 5 && d.text.size() <= 300
          && d.updatedAt == request.time;
      }
      allow read: if true;
      allow create: if isPatient() && request.auth.uid == uid && rvOk() && request.resource.data.createdAt == request.time;
      allow update: if isPatient() && request.auth.uid == uid && rvOk() && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin() || (active() && request.auth.uid == uid);
    }

    match /products/{id} {
      // الصورة: JPEG مضغوطة داخل المستند (حد أقصى 200 ألف حرف) أو رابط https
      function imgUrlOk() {
        let u = request.resource.data.get('imageUrl', '');
        return u is string && u.size() <= 200000 && (u == '' || u.matches('data:image/jpeg;base64,.*') || u.matches('https://.*'));
      }
      // حقول التصنيف والماركة والخصم: نصوص قصيرة، والسعر قبل الخصم (لو موجود) لازم يكون أكبر من السعر
      function metaOk() {
        let d = request.resource.data;
        return d.get('category', '') is string && d.get('category', '').size() <= 60
          && d.get('sub', '') is string && d.get('sub', '').size() <= 60
          && d.get('brand', '') is string && d.get('brand', '').size() <= 60
          && d.get('oldPrice', 0) is number && (d.get('oldPrice', 0) == 0 || d.get('oldPrice', 0) > d.price);
      }
      allow read: if true;
      allow create: if active() && request.resource.data.pharmacyId == request.auth.uid
        && exists(/databases/$(database)/documents/pharmacies/$(request.auth.uid)) && imgUrlOk() && metaOk();
      allow update: if active() && resource.data.pharmacyId == request.auth.uid
        && request.resource.data.pharmacyId == resource.data.pharmacyId && imgUrlOk() && metaOk();
      // صاحب الصيدلية يحذف منتجه، والأدمن يحذف أي منتج
      allow delete: if (active() && resource.data.pharmacyId == request.auth.uid) || isAdmin();
    }

    // ───────── الروشتات ─────────
    // الحالات: pending -> (quoted | need_info | unavailable) -> ordered | cancelled
    match /prescriptions/{id} {
      function ph() { return get(/databases/$(database)/documents/pharmacies/$(request.resource.data.pharmacyId)).data; }
      function imgOk(s) { return s is string && s.size() <= 300000 && s.matches('data:image/jpeg;base64,.*'); }
      function imgsOk() {
        let im = request.resource.data.images;
        return im is list && im.size() >= 1 && im.size() <= 3
          && imgOk(im[0])
          && (im.size() < 2 || imgOk(im[1]))
          && (im.size() < 3 || imgOk(im[2]));
      }
      function quoteOk() {
        let qt = request.resource.data.quote;
        return qt.keys().hasOnly(['items', 'total', 'note'])
          && qt.items is list && qt.items.size() > 0 && qt.items.size() <= 30
          && qt.total is number && qt.total > 0 && qt.total < 100000
          && (!('note' in qt) || (qt.note is string && qt.note.size() <= 500));
      }

      allow read: if active() && (resource.data.patientId == request.auth.uid || resource.data.pharmacyId == request.auth.uid) || isAdmin();

      allow create: if isPatient()
        && request.resource.data.keys().hasOnly(['patientId', 'patientName', 'pharmacyId', 'pharmacyName', 'phone', 'address', 'note', 'images', 'status', 'createdAt', 'updatedAt', 'dest'])
        && request.resource.data.keys().hasAll(['patientId', 'patientName', 'pharmacyId', 'pharmacyName', 'phone', 'address', 'note', 'images', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.patientName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && ph().status == 'active'
        && request.resource.data.pharmacyName == ph().name
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 8 && request.resource.data.phone.size() <= 20
        && request.resource.data.address is string && request.resource.data.address.size() >= 5 && request.resource.data.address.size() <= 300
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && imgsOk()
        && (!('dest' in request.resource.data) || destOk(request.resource.data.dest));

      allow update: if active() && (
        // الصيدلي: يرد بعرض سعر أو يطلب توضيح أو يعتذر
        (resource.data.pharmacyId == request.auth.uid
          && resource.data.status in ['pending', 'need_info', 'quoted']
          && request.resource.data.status in ['quoted', 'need_info', 'unavailable']
          && onlyKeys(['status', 'quote', 'updatedAt'])
          && (request.resource.data.status != 'quoted' || quoteOk()))
        || (resource.data.patientId == request.auth.uid && (
          // المريض: يرد على طلب التوضيح
          (resource.data.status == 'need_info' && request.resource.data.status == 'pending' && onlyKeys(['status', 'updatedAt']))
          // أو يلغي
          || (resource.data.status in ['pending', 'need_info', 'quoted'] && request.resource.data.status == 'cancelled' && onlyKeys(['status', 'updatedAt']))
          // أو يؤكد العرض: لازم يتكتب معاها طلب (في نفس الـ batch) مرتبط بيها ومطابق للعرض
          || (resource.data.status == 'quoted' && request.resource.data.status == 'ordered' && onlyKeys(['status', 'orderId', 'updatedAt'])
            && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.prescriptionId == id
            && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.patientId == request.auth.uid)
        ))
      );
      // مفيش حذف: الروشتات بتتلغي بس
    }

    match /prescriptions/{rid}/messages/{mid} {
      function rx() { return get(/databases/$(database)/documents/prescriptions/$(rid)).data; }
      allow read: if active() && (rx().patientId == request.auth.uid || rx().pharmacyId == request.auth.uid);
      allow create: if active()
        && (rx().patientId == request.auth.uid || rx().pharmacyId == request.auth.uid)
        && rx().status in ['pending', 'need_info', 'quoted']
        && request.resource.data.keys().hasOnly(['senderId', 'role', 'text', 'createdAt'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.role == (rx().patientId == request.auth.uid ? 'patient' : 'pharmacy')
        && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // ───────── المناديب والتتبع ─────────
    // المندوب حساب (role=courier) والصيدلية هي اللي بتربطه بيها. من غير مستند هنا المندوب مش بيشوف ولا يوصّل أي طلب.
    match /couriers/{cid} {
      allow read: if active() && (resource.data.pharmacyId == request.auth.uid || cid == request.auth.uid);
      allow create: if active() && request.resource.data.pharmacyId == request.auth.uid
        && exists(/databases/$(database)/documents/pharmacies/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(cid)).data.role == 'courier'
        && request.resource.data.keys().hasOnly(['pharmacyId', 'name', 'phone', 'active', 'createdAt'])
        && request.resource.data.keys().hasAll(['pharmacyId', 'name', 'phone', 'active', 'createdAt'])
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 8 && request.resource.data.phone.size() <= 20;
      allow update: if active() && resource.data.pharmacyId == request.auth.uid && onlyKeys(['active']);
    }

    // موقع المندوب اللحظي: بيكتبه المندوب المعيّن على الطلب وهو "out" بس، ويقراه المريض والصيدلية والمندوب
    match /tracking/{oid} {
      function ord() { return get(/databases/$(database)/documents/orders/$(oid)).data; }
      allow read: if active() && (ord().patientId == request.auth.uid || ord().pharmacyId == request.auth.uid || ord().get('courierId', null) == request.auth.uid) || isAdmin();
      allow create, update: if active() && ord().get('courierId', null) == request.auth.uid && ord().status == 'out'
        && request.resource.data.keys().hasOnly(['courierId', 'lat', 'lng', 'acc', 'speed', 'heading', 'updatedAt'])
        && request.resource.data.keys().hasAll(['courierId', 'lat', 'lng', 'updatedAt'])
        && request.resource.data.courierId == request.auth.uid
        && request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        && (!('acc' in request.resource.data) || request.resource.data.acc is number)
        && (!('speed' in request.resource.data) || request.resource.data.speed is number)
        && (!('heading' in request.resource.data) || request.resource.data.heading is number)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // ───────── المتواجدون الآن (لوحة الأدمن) ─────────
    // مستند لكل مستخدم مسجّل (id = uid) ولكل زائر (id = v_xxxx). الكتابة بتتحقق من الشكل والحجم، والقراءة والحذف للأدمن بس.
    // المسجّل مش بيقدر يكتب إلا مستنده هو؛ الاسم والدور بيتجابوا من users مش من هنا عشان ما يتزوروش.
    // ───────── المستندات الرسمية للصيدليات (سجل تجاري / بطاقة ضريبية / رخصة) ─────────
    // مش بتظهر لأي مستخدم: الصيدلية صاحبتها والأدمن بس. الصيدلية تقدر تستبدلها لحد ما تتوثّق. الأدمن بس يحذفها.
    match /pharmacyDocs/{pid} {
      function dimg(s) { return s is string && s.size() <= 250000 && s.matches('data:image/jpeg;base64,.*'); }
      function dshape() {
        let d = request.resource.data;
        return d.keys().hasOnly(['commercial', 'tax', 'license', 'createdAt', 'updatedAt'])
          && d.keys().hasAll(['commercial', 'tax', 'license', 'createdAt', 'updatedAt'])
          && dimg(d.commercial) && dimg(d.tax) && dimg(d.license) && d.updatedAt == request.time;
      }
      allow read: if (active() && request.auth.uid == pid) || isAdmin();
      allow create: if active() && request.auth.uid == pid
        && exists(/databases/$(database)/documents/pharmacies/$(pid))
        && dshape() && request.resource.data.createdAt == request.time;
      allow update: if active() && request.auth.uid == pid
        && get(/databases/$(database)/documents/pharmacies/$(pid)).data.verified == false
        && dshape() && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    // ───────── احتياج المناطق (عدّادات مجمّعة بدون بيانات شخصية) ─────────
    // أي زائر يقدر يزوّد عدّاد كلمة بحث/سلة لمحافظته بمقدار 1 بس؛ الأدمن بس هو اللي يقرأها.
    match /demand/{id} {
      allow read: if isAdmin();
      allow create, update: if request.resource.data.keys().hasOnly(['gov', 'term', 'k', 'n', 'last'])
        && id.matches('^[qc]_[0-9]{1,2}_[a-z0-9]{1,13}$')
        && request.resource.data.k in ['q', 'c'] && id[0:1] == request.resource.data.k
        && request.resource.data.gov is string && request.resource.data.gov.size() <= 20
        && request.resource.data.term is string && request.resource.data.term.size() >= 2 && request.resource.data.term.size() <= 40
        && request.resource.data.last == request.time
        && request.resource.data.n is int
        && request.resource.data.n == (resource == null ? 1 : resource.data.n + 1)
        && (resource == null || (resource.data.gov == request.resource.data.gov && resource.data.term == request.resource.data.term));
      allow delete: if isAdmin();
    }

    match /presence/{id} {
      function pOk() {
        let d = request.resource.data;
        return d.keys().hasOnly(['sid', 'uid', 'path', 'dev', 'mobile', 'ip', 'cc', 'gov', 'lat', 'lng', 'since', 'lastSeen'])
          && d.keys().hasAll(['uid', 'path', 'lastSeen'])
          && d.lastSeen == request.time
          && d.path is string && d.path.size() <= 80
          && (!('dev' in d) || (d.dev is string && d.dev.size() <= 60))
          && (!('mobile' in d) || d.mobile is bool)
          && (!('ip' in d) || (d.ip is string && d.ip.size() <= 45))
          && (!('cc' in d) || (d.cc is string && d.cc.size() <= 3))
          && (!('gov' in d) || (d.gov is string && d.gov.size() <= 20))
          && (!('lat' in d) || (d.lat is number && d.lat >= 21 && d.lat <= 32.5))
          && (!('lng' in d) || (d.lng is number && d.lng >= 24 && d.lng <= 37))
          && (!('since' in d) || d.since is number)
          && (!('sid' in d) || (d.sid is string && d.sid.size() <= 30))
          && ((d.uid == null && id.matches('v_[a-z0-9]{6,24}')) || (signed() && d.uid == request.auth.uid && id == request.auth.uid));
      }
      allow create, update: if pOk();
      allow read, delete: if isAdmin();
    }

    // ───────── الطلبات ─────────
    match /orders/{id} {
      function rxOf(rid) { return get(/databases/$(database)/documents/prescriptions/$(rid)).data; }
      // طلب جاي من روشتة لازم يطابق عرض الصيدلي بالظبط (الأصناف والإجمالي) وتكون الروشتة لسه "quoted"
      function rxLinked() {
        let d = request.resource.data;
        let r = rxOf(d.prescriptionId);
        return d.source == 'rx' && r.patientId == request.auth.uid && r.pharmacyId == d.pharmacyId
          && r.status == 'quoted' && d.total == r.quote.total && d.items == r.quote.items;
      }
      // الصيدلية بتعيّن مندوبها هي (شغّال ومربوط بيها)، والاسم والموبايل لازم يطابقوا ملفه
      function courierOk() {
        let c = get(/databases/$(database)/documents/couriers/$(request.resource.data.courierId)).data;
        return c.pharmacyId == request.auth.uid && c.active == true
          && request.resource.data.courierName == c.name && request.resource.data.courierPhone == c.phone;
      }

      allow create: if isPatient()
        && request.resource.data.keys().hasOnly(['patientId', 'patientName', 'phone', 'address', 'note', 'pharmacyId', 'pharmacyName', 'items', 'total', 'status', 'createdAt', 'updatedAt', 'dest', 'source', 'prescriptionId'])
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 30
        && (!('dest' in request.resource.data) || destOk(request.resource.data.dest))
        && (!('prescriptionId' in request.resource.data) || rxLinked());

      // (ترتيب الشروط مهم: المندوب آخر واحد عشان مستندات الطلبات القديمة اللي من غير courierId ما تعملش خطأ)
      allow read: if active() && (resource.data.patientId == request.auth.uid || resource.data.pharmacyId == request.auth.uid || resource.data.courierId == request.auth.uid || isAdmin());

      // انتقالات الحالة المسموحة بس
      allow update: if active() && (
        (resource.data.pharmacyId == request.auth.uid && (
          (onlyKeys(['status', 'updatedAt']) && (
            (resource.data.status == 'new' && request.resource.data.status in ['preparing', 'cancelled'])
            || (resource.data.status == 'preparing' && request.resource.data.status == 'out')
            || (resource.data.status == 'out' && request.resource.data.status == 'done')))
          // الخروج للتوصيل مع مندوب
          || (onlyKeys(['status', 'updatedAt', 'courierId', 'courierName', 'courierPhone'])
            && resource.data.status == 'preparing' && request.resource.data.status == 'out' && courierOk())))
        // المندوب المعيّن: يسلّم بس
        || (resource.data.get('courierId', null) == request.auth.uid && onlyKeys(['status', 'updatedAt'])
          && resource.data.status == 'out' && request.resource.data.status == 'done')
        // المريض: يلغي قبل القبول
        || (resource.data.patientId == request.auth.uid && onlyKeys(['status', 'updatedAt'])
          && resource.data.status == 'new' && request.resource.data.status == 'cancelled'));
    }
  }
}
